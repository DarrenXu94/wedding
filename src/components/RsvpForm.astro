---
const { canHavePlusOne } = Astro.props;
---

<form method="POST" action="/api/rsvp">
  <div class="stub-body">
    <div class="field-group">
      <label for="coming">Will you be able to attend?</label>
      <input type="text" id="coming" name="coming" autofocus />

      <label for="dietary">Dietary Restrictions</label>
      <input type="text" id="dietary" name="dietary" autofocus />

      <label for="notes">Additional Notes</label>
      <input type="text" id="notes" name="notes" autofocus />
    </div>

    {
      canHavePlusOne && (
        <div class="field-group">
          <label for="plusOneName">Plus One Name</label>
          <input type="text" id="plusOneName" name="plusOneName" autofocus />
        </div>
      )
    }

    <button type="submit">Unlock</button>
  </div>
</form>
